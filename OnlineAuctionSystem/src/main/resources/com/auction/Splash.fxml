<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="splashRoot" prefHeight="600.0" prefWidth="900.0"
           style="-fx-background-color: #0F172A;"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.auction.ui.controller.SplashController">
   <children>
      <VBox alignment="CENTER" spacing="30.0">
         <children>
            <Label fx:id="animatedWordLabel" text=""
                   style="-fx-text-fill: #F8FAFC; -fx-font-size: 46px; -fx-font-weight: bold; -fx-opacity: 0;" />
            <ImageView fx:id="logoImageView" fitHeight="120.0" fitWidth="120.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@images/logo.png" />
               </image>
            </ImageView>
            <VBox alignment="CENTER" spacing="8.0">
               <children>
                  <Label text="AUCTIONSYS"
                         style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 32px; -fx-letter-spacing: 6px;" />
                  <Label text="PREMIUM BIDDING PLATFORM"
                         style="-fx-text-fill: #94A3B8; -fx-font-size: 14px; -fx-letter-spacing: 2px;" />
               </children>
            </VBox>
         </children>
      </VBox>

      <Label text="v1.0" StackPane.alignment="BOTTOM_LEFT"
             style="-fx-text-fill: #64748B; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 24;" />

      <VBox alignment="BOTTOM_RIGHT" maxHeight="-Infinity" maxWidth="-Infinity" spacing="4.0"
            StackPane.alignment="BOTTOM_RIGHT"
            style="-fx-padding: 24;">
         <children>
            <Label fx:id="lblStatus" text="Đang kết nối tới máy chủ..."
                   style="-fx-text-fill: #3B82F6; -fx-font-size: 12px; -fx-font-weight: bold;" />
            <Label fx:id="logStreamLabel" text=""
                   style="-fx-text-fill: #64748B; -fx-font-size: 10px;" />
         </children>
      </VBox>
   </children>
</StackPane>